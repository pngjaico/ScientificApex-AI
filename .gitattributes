# Keep code, policy, manifests, and generated graph text stable across Windows
# and CI. Raw scientific/binary formats are explicitly excluded from text
# normalization.
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.pdf -text
*.docx -text
*.pptx -text
*.xlsx -text
*.zip -text
*.png -text
*.jpg -text
*.jpeg -text
*.tif -text
*.tiff -text
